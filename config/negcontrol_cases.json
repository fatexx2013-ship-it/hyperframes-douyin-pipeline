{
  "caseset_version": "1.1.0",
  "contract_ref": "config/param_contract.json@1.1.0",
  "created_at": "2026-09-24",
  "author": "file-agent",
  "source": "AI-Film-Studio (qpzRm) 两级负控执行节奏：不变量级——参数表版本变更即全量跑；探索级——按发布节奏每周抽跑；素材必须留档并绑定版本；1.1.0 追加扩展判定层用例（NC-09~NC-14）",
  "principle": "负控用例必须能被证伪：输入故意偏离合同口径，若判定不变红，说明检测器失效。每条用例都写清「触发条件 → 输入 → 期望判定 → 必填字段」，并绑定素材版本指纹。",
  "case_schema": {
    "id": "用例唯一号",
    "level": "invariant | exploratory（决定执行节奏）",
    "case_type": "negative_control（喂错输入必须判红） | positive_control（喂对输入必须判绿，证明检测器不是永远报红）",
    "trigger": {
      "condition": "contract_version_bump | weekly_schedule",
      "description": "该用例何时被调度执行"
    },
    "input": {
      "type": "real_fixture | real_fixture_pair | injected_manifest",
      "video": "被测成片路径（real_fixture 系列）",
      "story_dir": "可选，用于取声明时长",
      "baseline_video": "real_fixture_pair 的基线素材",
      "base_manifest": "injected_manifest 的底稿 manifest",
      "mutation": "injected_manifest 的注入项（path/value），用于以已知答案的合成输入测检测器本身"
    },
    "expect": [
      {
        "field": "字段名",
        "verdict": "FAIL | WARN | OK",
        "reason_contains": "可选，判定理由必须包含该子串"
      }
    ],
    "required_fields": "本用例输入/期望里必须齐全的字段（缺一即视为用例定义不完整）",
    "retention": "素材留档与版本绑定要求"
  },
  "execution_policy": {
    "invariant": {
      "label": "不变量级",
      "trigger": "参数表版本变更（contract_version bump）",
      "run_mode": "full（该级别用例全量跑）",
      "why": "不变量的价值就在「变更即验证」；若只按发布节奏跑，漂移会静默累积到成片才暴露，人耳回听时已经过了可用窗口。",
      "command": "python3 scripts/negcontrol.py run --level invariant"
    },
    "exploratory": {
      "label": "探索级",
      "trigger": "每周一次固定回归（本产线口径：每周一）",
      "run_mode": "sampled（按周抽跑）",
      "why": "探索级字段变更频繁，全量跑性价比低，但又必须防止静默累积。",
      "command": "python3 scripts/negcontrol.py run --level exploratory"
    },
    "material_binding": {
      "rule": "每条用例的素材必须登记 sha256 + size_bytes，并由 scripts/negcontrol.py verify-materials 定期校验；素材被替换或重编码后，旧用例的对照基线即失效，必须先复核再沿用。",
      "fixtures_dir": "reports/negcontrol/fixtures/",
      "note": "横版红样已从 1/.temp/OpenMontage/assets/ 归档进 fixtures 目录，避免临时目录被清理后用例无法复现。"
    }
  },
  "cases": [
